#!/bin/sh
# FARO Mobile's checked-in Gradle wrapper launcher. The companion wrapper JAR
# is committed so Android Studio and terminal builds use the same Gradle 8.9.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -n "$JAVA_HOME" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
elif [ -x "$APP_HOME/.jdk/Contents/Home/bin/java" ]; then
  JAVA_CMD="$APP_HOME/.jdk/Contents/Home/bin/java"
else
  JAVA_CMD="java"
fi
exec "$JAVA_CMD" ${JAVA_OPTS:-} -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
