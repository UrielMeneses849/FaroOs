<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application
    android:name=".FaroApplication"
    android:allowBackup="false"
    android:icon="@drawable/ic_faro_orb"
    android:label="FARO"
    android:roundIcon="@drawable/ic_faro_orb"
    android:supportsRtl="true"
    android:theme="@style/Theme.Faro">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:grantUriPermissions="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="faro" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="image/*" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>

    <receiver
      android:name=".quick.FaroWidgetProvider"
      android:exported="false"
      android:label="FARO Quick Actions">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/faro_widget_info" />
    </receiver>

    <service
      android:name=".quick.FaroQuickTileService"
      android:exported="true"
      android:icon="@drawable/ic_faro_orb"
      android:label="FARO"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
